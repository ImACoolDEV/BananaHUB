-- Mini Game (Orange Catcher)
local MiniGameGui = nil
local scoreVal = 0
safeBindClick(MiniGameBtn, function()
    Features.MiniGame = not Features.MiniGame
    MiniGameBtn.Text = Features.MiniGame and "🎮 Game: ACTIVE" or "🎮 Orange Catcher Game: OFF"
    MiniGG.Color = Features.MiniGame and ON_GRAD or OFF_GRAD
    if Features.MiniGame then
        if MiniGameGui then MiniGameGui:Destroy() end
        scoreVal = 0
        MiniGameGui = Instance.new("ScreenGui", ParentGui)
        MiniGameGui.Name = "BananaHubMiniGameGui"
        local GameFrame = Instance.new("Frame", MiniGameGui)
        GameFrame.Size = UDim2.new(0, 240, 0, 300); GameFrame.Position = UDim2.new(0.7, 0, 0.3, 0)
        GameFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30); makeDraggable(GameFrame)
        Instance.new("UICorner", GameFrame); Instance.new("UIStroke", GameFrame).Color = Color3.fromRGB(255, 200, 0)

        local ScoreLbl = Instance.new("TextLabel", GameFrame)
        ScoreLbl.Size = UDim2.new(1, 0, 0, 30); ScoreLbl.BackgroundTransparency = 1
        ScoreLbl.Text = "🍊 Score: 0"; ScoreLbl.TextColor3 = Color3.fromRGB(255, 200, 0); ScoreLbl.Font = Enum.Font.GothamBold

        local PlayArea = Instance.new("Frame", GameFrame)
        PlayArea.Size = UDim2.new(1, -16, 1, -45); PlayArea.Position = UDim2.new(0, 8, 0, 35)
        PlayArea.BackgroundColor3 = Color3.fromRGB(30, 28, 38); PlayArea.ClipsDescendants = true
        Instance.new("UICorner", PlayArea)

        local Basket = Instance.new("TextButton", PlayArea)
        Basket.Size = UDim2.new(0, 60, 0, 22); Basket.Position = UDim2.new(0.5, -30, 1, -25)
        Basket.BackgroundColor3 = Color3.fromRGB(220, 160, 0); Basket.Text = "🧺 Basket"; Basket.TextColor3 = Color3.new(1,1,1)
        Instance.new("UICorner", Basket)

        local draggingBasket = false
        Basket.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingBasket = true end end)
        UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingBasket = false end end)
        UserInputService.InputChanged:Connect(function(input)
            if draggingBasket and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local relativeX = input.Position.X - PlayArea.AbsolutePosition.X
                local clampedX = math.clamp(relativeX - 30, 0, PlayArea.AbsoluteSize.X - 60)
                Basket.Position = UDim2.new(0, clampedX, 1, -25)
            end
        end)

        Tasks.MiniGameTask = task.spawn(function()
            while Features.MiniGame do
                task.wait(math.random(1, 2))
                if not Features.MiniGame then break end
                local Orange = Instance.new("TextButton", PlayArea)
                Orange.Size = UDim2.new(0, 20, 0, 20); Orange.Position = UDim2.new(0, math.random(10, PlayArea.AbsoluteSize.X - 30), 0, 0)
                Orange.BackgroundColor3 = Color3.fromRGB(255, 140, 0); Orange.Text = "🍊"; Instance.new("UICorner", Orange).CornerRadius = UDim.new(1, 0)

                task.spawn(function()
                    while Orange and Orange.Parent and Features.MiniGame do
                        Orange.Position = Orange.Position + UDim2.new(0, 0, 0, 4)
                        if math.abs(Orange.AbsolutePosition.X - Basket.AbsolutePosition.X) < 45 and math.abs(Orange.AbsolutePosition.Y - Basket.AbsolutePosition.Y) < 20 then
                            scoreVal = scoreVal + 1; ScoreLbl.Text = "🍊 Score: " .. scoreVal; Orange:Destroy(); break
                        end
                        if Orange.Position.Y.Offset > PlayArea.AbsoluteSize.Y then Orange:Destroy(); break end
                        task.wait(0.03)
                    end
                end)
            end
        end)
    else
        if MiniGameGui then MiniGameGui:Destroy(); MiniGameGui = nil end
        if Tasks.MiniGameTask then task.cancel(Tasks.MiniGameTask); Tasks.MiniGameTask = nil end
    end
end)
