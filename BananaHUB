local function CreateBtn(text, order)
    local btn = Instance.new("TextButton", ScrollingFrame)
    btn.BackgroundColor3 = Color3.fromRGB(35, 32, 22); btn.Text = text; btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold; btn.TextSize = 10; btn.LayoutOrder = order
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local grad = Instance.new("UIGradient", btn); grad.Color = OFF_GRAD; grad.Rotation = 90
    local stroke = Instance.new("UIStroke", btn); stroke.Thickness = 1; stroke.Color = Color3.fromRGB(100, 90, 70)
    return btn, stroke, grad
end

