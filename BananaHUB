-- Fly Hack Logic
local bodyVel, bodyGyro
FlyBtn.Activated:Connect(function()
    Features.Fly = not Features.Fly
    FlyBtn.Text = Features.Fly and "🦅 Fly Hack: ON" or "🦅 Fly Hack: OFF"
    FlyG.Color = Features.Fly and ON_GRAD or OFF_GRAD
